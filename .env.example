# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Set to "offline" to use the free rule-based client instead of Gemini
CLERKAI_LLM=
# Optional: comma-separated models to try when the main one is overloaded
GEMINI_FALLBACK_MODELS=gemini-3.7-flash,gemini-3.5-flash-lite

# Inbox automation (python -m clerkai watch). Use a demo inbox, never a personal one.
CLERKAI_IMAP_HOST=imap.gmail.com
CLERKAI_IMAP_USER=your-demo-inbox@gmail.com
# A Gmail App Password (Google Account > Security > App passwords), not the account password
CLERKAI_IMAP_PASSWORD=
# Optional Slack incoming-webhook URL for alerts; without it alerts are printed
CLERKAI_SLACK_WEBHOOK=
# Optional model prices in USD per million tokens, for cost tracking
CLERKAI_PRICE_IN_PER_M=
CLERKAI_PRICE_OUT_PER_M=
